# Copiez ce fichier en .env.local (ignoré par git) puis renseignez les valeurs.

# Clé OpenWeatherMap (32 caractères hexadécimaux), utilisée UNIQUEMENT côté serveur :
# par la Vercel Function api/weather.ts en production (variable d'environnement Vercel)
# et par le serveur de développement Vite en local. Sans préfixe VITE_, elle n'est
# jamais incluse dans le bundle publié.
OWM_API_KEY=

# Optionnel : adresse du proxy météo appelé par le navigateur (URL https ou chemin
# relatif). Par défaut "/api/weather" (même origine : Vercel et `npm run dev`).
# Le build GitHub Pages utilise https://meteoci.vercel.app/api/weather.
VITE_WEATHER_API_BASE=
